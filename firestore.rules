rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isNotBlocked() {
      return isAuthenticated() && getUserRole() != 'blocked';
    }

    function isAdminOrEditor() {
      return isAuthenticated() && getUserRole() in ['admin', 'editor'];
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() in ['admin'];
    }

    // Cifras + Índice — leitura aberta (exceto blocked), escrita admin/editor
    match /cifras/{docId} {
      allow read: if !isAuthenticated() || isNotBlocked();
      allow write: if isAdminOrEditor();
    }
    match /cifras_indice/{docId} {
      allow read: if !isAuthenticated() || isNotBlocked();
      allow write: if isAdminOrEditor();
    }

    // Config
    match /config/{document=**} {
      allow read, write: if isAdmin();
    }

    // Listas
    match /listas/{docId} {
      allow read: if !isAuthenticated() || isNotBlocked();
      allow write: if isAdminOrEditor();
    }

    // Acordes
    match /acordes/{docId} {
      allow read: if !isAuthenticated() || isNotBlocked();
      allow write: if isAdminOrEditor();
    }

    // Users
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == uid || isAdminOrEditor();
    }

    // Grupos
    match /grupos/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Convites
    match /convites/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
