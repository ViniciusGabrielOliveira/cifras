rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.role : 'visitante';
    }

    function isNotBlocked() {
      return isAuthenticated() && getUserRole() != 'blocked';
    }

    function isAdminOrEditor() {
      return isAuthenticated() && getUserRole() in ['admin', 'editor'];
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() in ['admin'];
    }

    function isListaOwner(lista) {
      return isAuthenticated() && lista.donoUid == request.auth.uid;
    }

    function isListaParticipant(lista) {
      return isAuthenticated()
        && lista.tipo == 'privada'
        && lista.participantes != null
        && lista.participantes.filter(p, p.uid == request.auth.uid).size() > 0;
    }

    function isListaEditor(lista) {
      return isAuthenticated()
        && lista.tipo == 'privada'
        && lista.participantes != null
        && lista.participantes.filter(p, p.uid == request.auth.uid && p.role == 'editor').size() > 0;
    }

    // ── Helpers de visibilidade ──────────────────────────────────────
    function cifraVisivelViaLista(cifra) {
      // Verifica participação nas listas onde a cifra está adicionada (até 4 listas)
      let lids = cifra.listasIds;
      return lids != null && (
        (lids.size() >= 1 && get(/databases/$(database)/documents/listas/$(lids[0])).data.participantesUids.hasAny([request.auth.uid]))
        || (lids.size() >= 2 && get(/databases/$(database)/documents/listas/$(lids[1])).data.participantesUids.hasAny([request.auth.uid]))
        || (lids.size() >= 3 && get(/databases/$(database)/documents/listas/$(lids[2])).data.participantesUids.hasAny([request.auth.uid]))
        || (lids.size() >= 4 && get(/databases/$(database)/documents/listas/$(lids[3])).data.participantesUids.hasAny([request.auth.uid]))
      );
    }

    // ── Cifras ───────────────────────────────────────────────────────
    match /cifras/{docId} {
      allow read: if
        // Admin sempre lê
        isAdmin()
        // Cifra pública: qualquer não-bloqueado
        || ((!resource.data.keys().hasAll(['status']) || resource.data.status == 'publica')
          && (!isAuthenticated() || isNotBlocked()))
        // Dono sempre lê sua própria
        || (isAuthenticated() && resource.data.donoUid == request.auth.uid)
        // Cifra privada/pendente: participante de uma lista que contém esta cifra
        || (isAuthenticated() && isNotBlocked()
          && (resource.data.status == 'privada' || resource.data.status == 'pendente_revisao')
          && cifraVisivelViaLista(resource.data));

      // Criar nova cifra (privada ou pendente_revisao)
      allow create: if isAdminOrEditor()
        || (isAuthenticated() && isNotBlocked()
          && request.resource.data.donoUid == request.auth.uid
          && request.resource.data.status in ['privada', 'pendente_revisao']);

      // Editar cifra existente
      allow update: if isAdminOrEditor()
        // Dono pode editar sua própria privada/pendente (sem mudar status para público diretamente)
        || (isAuthenticated() && isNotBlocked()
          && resource.data.donoUid == request.auth.uid
          && request.resource.data.donoUid == request.auth.uid
          && request.resource.data.status in ['privada', 'pendente_revisao']);

      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.donoUid == request.auth.uid);
    }

    // ── Versões de cifras (histórico aprovado) ───────────────────────
    match /cifras/{docId}/versoes/{versaoId} {
      allow read: if !isAuthenticated() || isNotBlocked();
      allow write: if isAdmin();
    }

    // ── Pull Requests de cifras ──────────────────────────────────────
    match /cifras_pr/{prId} {
      allow read: if isAdmin()
        // Autor sempre lê sua própria PR
        || (isAuthenticated() && resource.data.autorUid == request.auth.uid)
        // Participantes de listas onde a cifra está presente
        || (isAuthenticated() && isNotBlocked()
          && resource.data.cifraId != null
          && cifraVisivelViaLista(get(/databases/$(database)/documents/cifras/$(resource.data.cifraId)).data));

      allow create: if isAuthenticated() && isNotBlocked()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.status == 'pendente';

      // Autor pode cancelar sua PR pendente; admin pode aprovar/rejeitar
      allow update: if isAdmin()
        || (isAuthenticated()
          && resource.data.autorUid == request.auth.uid
          && resource.data.status == 'pendente'
          && request.resource.data.status == 'pendente');

      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.autorUid == request.auth.uid && resource.data.status == 'pendente');
    }

    // ── Índice de Cifras ─────────────────────────────────────────────
    match /cifras_indice/{docId} {
      allow read: if !isAuthenticated() || isNotBlocked();
      allow write: if isAdminOrEditor();
    }

    // ── Cifras Customizadas (edições do usuário sobre cifras públicas) ─
    match /cifras_custom/{docId} {
      allow read, write: if isAuthenticated()
        && isNotBlocked()
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // ── Config ───────────────────────────────────────────────────────
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Listas ───────────────────────────────────────────────────────
    match /listas/{docId} {
      allow read: if
        // Admin lê tudo
        isAdmin()
        // Lista pública
        || ((!resource.data.keys().hasAll(['tipo']) || resource.data.tipo == 'publica')
          && (!isAuthenticated() || isNotBlocked()))
        // Lista privada: dono ou participante
        || (resource.data.tipo == 'privada'
          && (isListaOwner(resource.data) || isListaParticipant(resource.data)))
        // Lista privada com token de convite: leitura pública para exibir a tela de convite
        || (resource.data.tipo == 'privada'
          && resource.data.keys().hasAll(['tokenConvite'])
          && resource.data.tokenConvite != null);

      allow create: if isAdminOrEditor()
        // Usuário criando lista privada
        || (isAuthenticated() && isNotBlocked()
          && request.resource.data.tipo == 'privada'
          && request.resource.data.donoUid == request.auth.uid);

      allow update: if isAdminOrEditor()
        // Dono da lista privada pode atualizar tudo
        || (isAuthenticated() && resource.data.tipo == 'privada'
          && isListaOwner(resource.data))
        // Editor pode atualizar a lista
        || (isAuthenticated() && resource.data.tipo == 'privada'
          && isListaEditor(resource.data))
        // Auto-join via token: qualquer autenticado pode se adicionar como participante
        // desde que só altere os campos participantes/participantesUids
        || (isAuthenticated()
          && resource.data.tipo == 'privada'
          && resource.data.tokenConvite != null
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participantes', 'participantesUids']));

      allow delete: if isAdmin()
        || (isAuthenticated()
          && resource.data.tipo == 'privada'
          && isListaOwner(resource.data));
    }

    // ── Live state (subcoleção de listas) ────────────────────────────
    match /listas/{listaId}/live/{docId} {
      allow read: if isAuthenticated()
        && exists(/databases/$(database)/documents/listas/$(listaId))
        && (
          get(/databases/$(database)/documents/listas/$(listaId)).data.donoUid == request.auth.uid
          || get(/databases/$(database)/documents/listas/$(listaId)).data
               .get('participantesUids', []).hasAny([request.auth.uid])
        );

      allow write: if isAuthenticated()
        && exists(/databases/$(database)/documents/listas/$(listaId))
        && (
          get(/databases/$(database)/documents/listas/$(listaId)).data.donoUid == request.auth.uid
          || get(/databases/$(database)/documents/listas/$(listaId)).data
               .get('controladoresUids', []).hasAny([request.auth.uid])
        );
    }

    // ── Acordes ──────────────────────────────────────────────────────
    match /acordes/{docId} {
      allow read: if !isAuthenticated() || isNotBlocked();
      allow write: if isAdminOrEditor();
    }

    // ── Users ────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == uid || isAdminOrEditor();
    }

    // ── Grupos ───────────────────────────────────────────────────────
    match /grupos/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Convites ─────────────────────────────────────────────────────
    match /convites/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
