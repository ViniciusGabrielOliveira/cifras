# Chave de autenticação da API — obrigatória em produção
# Gere uma chave aleatória: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=troque-por-uma-chave-segura

# Origens permitidas pelo CORS (separadas por vírgula)
# Use * para permitir qualquer origem (não recomendado em produção)
ALLOWED_ORIGINS=http://localhost:4200,https://seu-dominio.github.io
